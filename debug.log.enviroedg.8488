                REPLACE INTO function_call_coverage (id, function_id, line, name, hit_count, max_hit_count,
                                                     annotations_count, max_annotations_count, unique_id,
                                                     source_function_call_coverage_id, mangled_name, is_function_pointer)
                    SELECT function_call_coverage.id,
