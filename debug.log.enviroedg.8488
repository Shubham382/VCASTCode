DBG_Q 06166> ( 62083.257013800) Preparing query: '
        CREATE TRIGGER IF NOT EXISTS add_aggregate_coverage
            AFTER UPDATE OF enabled ON results
            FOR EACH ROW WHEN
                NEW.enabled = 1 AND
                OLD.enabled = 0
            BEGIN
                REPLACE INTO function_call_coverage (id, function_id, line, name, hit_count, max_hit_count, annotations_count,
                                                     max_annotations_count, unique_id, source_function_call_coverage_id,
                                                     mangled_name, is_function_pointer)
                    SELECT function_call_coverage.id,
                           function_call_coverage.function_id,
                           function_call_coverage.line,
                           function_call_coverage.name,
                           function_call_coverage.hit_count + sum(function_call_data.hit AND results.coverage_by_analysis=0),
                           function_call_coverage.max_hit_count,
                           function_call_coverage.annotations_count + sum(function_call_data.hit AND results.coverage_by_analysis=1),
                           function_call_coverage.max_annotations_count,
                           function_call_coverage.unique_id,
                           function_call_coverage.source_function_call_coverage_id,
                           function_call_coverage.mangled_name,
                           function_call_coverage.is_function_pointer
                    FROM function_call_coverage, function_call_data, results
                    WHERE results.id = NEW.id AND
                          function_call_data.result_id = results.id AND
                          function_call_data.func_call_id = function_call_coverage.id
                    GROUP BY function_call_data.func_call_id;

                REPLACE INTO function_coverage (id, function_id, hit_count, max_hit_count,
                                                unique_id, annotations_count, max_annotations_count, line,
                                                source_function_coverage_id)
                    SELECT function_coverage.id,
                           function_coverage.function_id,
                           function_coverage.hit_count + sum(function_data.hit AND results.coverage_by_analysis=0),
                           function_coverage.max_hit_count,
                           function_coverage.unique_id,
                           function_coverage.annotations_count + sum(function_data.hit AND results.coverage_by_analysis=1),
                           function_coverage.max_annotations_count,
                           function_coverage.line,
                           function_coverage.source_function_coverage_id
                    FROM function_coverage, function_data, results
                    WHERE results.id = NEW.id AND
                          function_data.result_id = results.id AND
                          function_data.function_id = function_coverage.id
                    GROUP BY function_data.function_id;

                REPLACE INTO statement_coverage (id, function_id, line, hit_count, max_hit_count,
                                                 unique_id, annotations_count, max_annotations_count,
                                                 source_statement_coverage_id)
                    SELECT statement_coverage.id,
                           statement_coverage.function_id,
                           statement_coverage.line,
                           statement_coverage.hit_count + sum(statement_data.hit AND results.coverage_by_analysis=0),
                           statement_coverage.max_hit_count,
                           statement_coverage.unique_id,
                           statement_coverage.annotations_count + sum(statement_data.hit AND results.coverage_by_analysis=1),
                           statement_coverage.max_annotations_count,
                           statement_coverage.source_statement_coverage_id
                    FROM statement_coverage, statement_data, results
                    WHERE results.id = NEW.id AND
                          statement_data.result_id = results.id AND
                          statement_data.statement_id = statement_coverage.id
                    GROUP BY statement_data.statement_id;

                REPLACE INTO branch_coverage (id, function_id, line, num_conditions, true_count,
                                              false_count, max_true_count, max_false_count,
                                              unique_id, annotations_true_count, annotations_false_count,
                                              max_annotations_true_count, max_annotations_false_count,
                                              single_condition_value, source_branch_coverage_id,
                                              is_function_entry)
                    SELECT branch_coverage.id,
                           branch_coverage.function_id,
                           branch_coverage.line,
                           branch_coverage.num_conditions,
                           branch_coverage.true_count + sum(branch_data.taken=1 AND results.coverage_by_analysis=0),
                           branch_coverage.false_count + sum(branch_data.taken=0 AND results.coverage_by_analysis=0),
                           branch_coverage.max_true_count,
                           branch_coverage.max_false_count,
                           branch_coverage.unique_id,
                           branch_coverage.annotations_true_count + sum(branch_data.taken=1 AND results.coverage_by_analysis=1),
                           branch_coverage.annotations_false_count + sum(branch_data.taken=0 AND results.coverage_by_analysis=1),
                           branch_coverage.max_annotations_true_count,
                           branch_coverage.max_annotations_false_count,
                           branch_coverage.single_condition_value,
                           branch_coverage.source_branch_coverage_id,
                           branch_coverage.is_function_entry
                    FROM branch_coverage, branch_data, results
                    WHERE results.id = NEW.id AND
                          branch_data.result_id = results.id AND
                          branch_data.branch_id = branch_coverage.id
                    GROUP BY branch_data.branch_id;

            REPLACE INTO mcdc_coverage_conditions (id, mcdc_id, cond_index, true_count, false_count,
                                                   max_true_count, max_false_count, cond_variable, cond_expr,
                                                   annotations_true_count, annotations_false_count,
                                                   max_annotations_true_count, max_annotations_false_count,
                                                   startline, startcol, endline, endcol, source_mcdc_coverage_conditions_id,
                                                   startcol_tu, endcol_tu, startline_tu, endline_tu)
                SELECT mcdc_coverage_conditions.id,
                       mcdc_data.mcdc_id,
                       mcdc_data_conditions.cond_index,
                       true_count + sum(cond_value=1 AND results.coverage_by_analysis=0),
                       false_count + sum(cond_value=0 AND results.coverage_by_analysis=0),
                       mcdc_coverage_conditions.max_true_count,
                       mcdc_coverage_conditions.max_false_count,
                       mcdc_coverage_conditions.cond_variable,
                       mcdc_coverage_conditions.cond_expr,
                       mcdc_coverage_conditions.annotations_true_count + sum(cond_value=1 AND results.coverage_by_analysis=1),
                       mcdc_coverage_conditions.annotations_false_count + sum(cond_value=0 AND results.coverage_by_analysis=1),
                       mcdc_coverage_conditions.max_annotations_true_count,
                       mcdc_coverage_conditions.max_annotations_false_count,
                       mcdc_coverage_conditions.startline,
                       mcdc_coverage_conditions.startcol,
                       mcdc_coverage_conditions.endline,
                       mcdc_coverage_conditions.endcol,
                       mcdc_coverage_conditions.source_mcdc_coverage_conditions_id,
                       mcdc_coverage_conditions.startcol_tu,
                       mcdc_coverage_conditions.endcol_tu,
                       mcdc_coverage_conditions.startline_tu,
                       mcdc_coverage_conditions.endline_tu
                FROM mcdc_data, mcdc_data_conditions, mcdc_coverage_conditions, results
                WHERE results.id = NEW.id AND
                      mcdc_data.result_id = results.id AND
                      mcdc_data.id = mcdc_data_conditions.mcdc_data_id AND
                      mcdc_coverage_conditions.mcdc_id = mcdc_data.mcdc_id AND
                      mcdc_coverage_conditions.cond_index = mcdc_data_conditions.cond_index
                GROUP BY mcdc_coverage_conditions.id,
                      mcdc_data.mcdc_id,
                      mcdc_data_conditions.cond_index;
            REPLACE INTO mcdc_coverage_pair_rows (id, mcdc_id, row_value, row_result, hit_count, max_hit_count,
                                                annotations_count, max_annotations_count)
                SELECT mcdc_coverage_pair_rows.id,
                       mcdc_coverage_pair_rows.mcdc_id,
                       mcdc_coverage_pair_rows.row_value,
                       mcdc_coverage_pair_rows.row_result,
                       mcdc_coverage_pair_rows.hit_count + (results.coverage_by_analysis=0),
                       mcdc_coverage_pair_rows.max_hit_count,
                       mcdc_coverage_pair_rows.annotations_count + (results.coverage_by_analysis=1),
                       mcdc_coverage_pair_rows.max_annotations_count
                FROM mcdc_data, mcdc_coverage_pair_rows, results
                WHERE results.id = NEW.id AND
                      mcdc_data.result_id = results.id AND
                      mcdc_data.mcdc_id = mcdc_coverage_pair_rows.mcdc_id AND
                      ((mcdc_coverage_pair_rows.row_value-1) & mcdc_data.used_value) = (mcdc_data.pair_value & mcdc_data.used_value);
            END
        '
DBG_Q 06167> ( 62083.257832500) Preparing query: '
        CREATE TRIGGER IF NOT EXISTS subtract_aggregate_coverage
            AFTER UPDATE OF enabled ON results
            FOR EACH ROW WHEN
                NEW.enabled = 0 AND
                OLD.enabled = 1
